{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teralace",
  "version": "1.2.1",
  "identifier": "com.teralace.downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Teralace - TeraBox Downloader",
        "width": 860,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Network",
    "shortDescription": "Fast and resilient multiplatform TeraBox downloader",
    "longDescription": "Teralace is a fast, multi-threaded TeraBox file downloader built with Tauri v2, Rust, and React.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
